PORT=7900
APP_ENV=development
DATABASE_URL=sqlite://data/llmroute.db?mode=rwc
REDIS_URL=redis://127.0.0.1:6379/
JWT_SECRET=generate-a-unique-secret-at-least-32-characters
DEV_PASSWORD=set-a-unique-bootstrap-admin-password
INITIAL_USER_PASSWORD=set-a-unique-initial-user-password
UPSTREAM_API_KEY=replace-with-your-provider-key
CREDENTIALS_ENCRYPTION_KEY=generate-a-base64-encoded-32-byte-key
RUST_LOG=info
# Generate a private random value before enabling the user-isolated Agent sandbox.
AGENT_SANDBOX_SECRET=replace-with-a-long-random-secret
AGENT_SANDBOX_URL=http://agent-sandbox:8090
